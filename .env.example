# BreachHound configuration - copy to .env (never commit .env)
# Generate it interactively with:  python cli.py configure

# LLM provider: none | cloud | ollama   (none = deterministic analysis only)
BREACHHOUND_LLM_PROVIDER=none

# --- Cloud provider (OpenAI-compatible or Anthropic API) ---
# Presets: openai | anthropic | openrouter | custom
BREACHHOUND_CLOUD_PRESET=openai
# BREACHHOUND_CLOUD_API_STYLE=openai
# BREACHHOUND_CLOUD_ENDPOINT=https://api.openai.com/v1
# BREACHHOUND_CLOUD_MODEL=gpt-4o-mini
BREACHHOUND_CLOUD_API_KEY=

# --- Ollama (local) ---
BREACHHOUND_OLLAMA_ENDPOINT=http://localhost:11434
BREACHHOUND_OLLAMA_MODEL=llama3.1

# --- LLM behaviour ---
BREACHHOUND_LLM_TIMEOUT=60
BREACHHOUND_LLM_RETRIES=2
# Language of the LLM answers (fr | en)
BREACHHOUND_LANGUAGE=fr

# --- Detection tuning (optional) ---
# BREACHHOUND_BRUTE_FORCE_THRESHOLD=5
# BREACHHOUND_BRUTE_FORCE_WINDOW=300
# BREACHHOUND_CORRELATION_WINDOW=3600
# BREACHHOUND_RECENT_DAYS=7
# BREACHHOUND_MAX_LINE_LENGTH=8192
# BREACHHOUND_MAX_LINES=5000000
# BREACHHOUND_SYSLOG_YEAR=2026
